# Copy to judge0.conf (chmod 600) and replace every <...>. Generate secrets with: openssl rand -hex 24
# The platform's .env must carry the same client id/secret (LEARNHOUSE_JUDGE0_CLIENT_ID / _SECRET).
ENABLE_BATCHED_SUBMISSIONS=true
ENABLE_ADDITIONAL_FILES=true
ENABLE_WAIT_RESULT=true
MAX_QUEUE_SIZE=100
COUNT=1
AUTHN_HEADER=X-Judge0-Client
AUTHN_TOKEN=<secret>
AUTHZ_HEADER=X-Judge0-Secret
AUTHZ_TOKEN=<secret>
REDIS_HOST=redis
REDIS_PASSWORD=<secret>
POSTGRES_HOST=db
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=<secret>
CPU_TIME_LIMIT=5
MAX_CPU_TIME_LIMIT=10
WALL_TIME_LIMIT=10
MAX_WALL_TIME_LIMIT=20
MEMORY_LIMIT=256000
MAX_MEMORY_LIMIT=256000
MAX_PROCESSES_AND_OR_THREADS=60
ENABLE_NETWORK=false
ALLOW_ENABLE_NETWORK=false
RAILS_ENV=production
SECRET_KEY_BASE=<secret>
