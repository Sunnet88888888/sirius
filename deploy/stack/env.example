# Copy to .env (chmod 600) in the stack directory and fill every <...>. Never commit the real file.
# Generate secrets with: openssl rand -hex 24
LEARNHOUSE_DOMAIN=<domain>
HTTP_PORT=80
NEXT_PUBLIC_LEARNHOUSE_API_URL=https://<domain>/api/v1/
NEXT_PUBLIC_LEARNHOUSE_BACKEND_URL=https://<domain>/
NEXT_PUBLIC_LEARNHOUSE_DOMAIN=<domain>
NEXT_PUBLIC_LEARNHOUSE_TOP_DOMAIN=<domain>
NEXT_PUBLIC_LEARNHOUSE_MULTI_ORG=false
NEXT_PUBLIC_LEARNHOUSE_DEFAULT_ORG=<org-slug>
NEXT_PUBLIC_LEARNHOUSE_HTTPS=True
NEXTAUTH_URL=https://<domain>
NEXTAUTH_SECRET=<secret>
POSTGRES_USER=learnhouse
POSTGRES_PASSWORD=<secret>
POSTGRES_DB=learnhouse
LEARNHOUSE_SQL_CONNECTION_STRING=postgresql://learnhouse:<same-postgres-password>@db:5432/learnhouse
LEARNHOUSE_REDIS_CONNECTION_STRING=redis://redis:6379/learnhouse
LEARNHOUSE_REDIS_URL=redis://redis:6379/learnhouse
LEARNHOUSE_COOKIE_DOMAIN=
LEARNHOUSE_PORT=9000
LEARNHOUSE_AUTH_JWT_SECRET_KEY=<secret>
LEARNHOUSE_INITIAL_ADMIN_EMAIL=<admin-email>
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=<strong-password>
LEARNHOUSE_INITIAL_ORG_NAME=<org-name>
LEARNHOUSE_INITIAL_ORG_SLUG=<org-slug>
LEARNHOUSE_TENANCY=single
COLLAB_INTERNAL_KEY=<secret>
NEXT_PUBLIC_COLLAB_URL=wss://<domain>/collab
LEARNHOUSE_DEVELOPMENT_MODE=false
LEARNHOUSE_LOGFIRE_ENABLED=false

# AI
LEARNHOUSE_IS_AI_ENABLED=true
LEARNHOUSE_AI_PROVIDER=openai
LEARNHOUSE_AI_API_KEY=<openai-key>
LEARNHOUSE_AI_MODEL_FAST=<model>
LEARNHOUSE_AI_MODEL_STANDARD=<model>
LEARNHOUSE_AI_MODEL_PRO=<model>
LEARNHOUSE_AI_EMBEDDING_PROVIDER=openai
LEARNHOUSE_AI_EMBEDDING_MODEL=<model>
LEARNHOUSE_AI_EMBEDDING_DIMENSIONS=<n>

# Code execution (Judge0 stack, see ../judge0)
LEARNHOUSE_JUDGE0_API_URL=http://judge0:2358
LEARNHOUSE_JUDGE0_CLIENT_ID=<same as AUTHN_TOKEN in judge0.conf>
LEARNHOUSE_JUDGE0_CLIENT_SECRET=<same as AUTHZ_TOKEN in judge0.conf>

# Platform switches (docs/features/hidden-features.md, docs/features/analytics.md)
SIRIUS_HIDDEN_FEATURES=boards,playgrounds
SIRIUS_UNLOCKED_FEATURES=analytics_advanced

# AI code review limits per student (docs/features/ai-code-review.md)
LEARNHOUSE_AI_REVIEW_DAILY_LIMIT=<n>
LEARNHOUSE_AI_REVIEW_MONTHLY_LIMIT=<n>
LEARNHOUSE_AI_REVIEW_TIER=<tier>

# Analytics (deploy/analytics/README.md)
CLICKHOUSE_USER=sirius_analytics
CLICKHOUSE_PASSWORD=<secret>
LEARNHOUSE_TINYBIRD_API_URL=http://analytics-proxy:8080
LEARNHOUSE_TINYBIRD_INGEST_TOKEN=<secret>
LEARNHOUSE_TINYBIRD_READ_TOKEN=<secret>

# Object storage (any S3-compatible service; Selectel shown) and HLS video
LEARNHOUSE_CONTENT_DELIVERY_TYPE=s3api
LEARNHOUSE_S3_API_BUCKET_NAME=<bucket>
LEARNHOUSE_S3_API_ENDPOINT_URL=https://s3.<region>.storage.selcloud.ru
LEARNHOUSE_S3_API_REGION=<region, e.g. ru-7>
LEARNHOUSE_S3_API_ADDRESSING_STYLE=virtual   # bucket.s3.host URLs; needed for CORS on Selectel
AWS_ACCESS_KEY_ID=<access-key>
AWS_SECRET_ACCESS_KEY=<secret-key>
AWS_DEFAULT_REGION=<region>
LEARNHOUSE_HLS_ENABLED=true
LEARNHOUSE_HLS_CONCURRENCY=1
LEARNHOUSE_HLS_FFMPEG_THREADS=1

# Email (password reset, magic links). Resend shown; the sender address must be on a domain verified in Resend.
# Without a verified domain Resend only delivers from onboarding@resend.dev to the Resend account owner.
LEARNHOUSE_EMAIL_PROVIDER=resend
LEARNHOUSE_RESEND_API_KEY=<resend-api-key, sending access>
LEARNHOUSE_SYSTEM_EMAIL_ADDRESS=noreply@mail.<your-domain>
LEARNHOUSE_SYSTEM_EMAIL_SENDER_NAME=SIRIUS
# SMTP instead: LEARNHOUSE_EMAIL_PROVIDER=smtp and LEARNHOUSE_SMTP_HOST / _PORT / _USERNAME / _PASSWORD / _USE_TLS

# Sign in with Google (OAuth client of type "Web application")
# Authorized JavaScript origin: https://<your-domain>   Redirect URI: https://<your-domain>/auth/callback/google
LEARNHOUSE_GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
LEARNHOUSE_GOOGLE_CLIENT_SECRET=<client-secret>

# Address used in links inside emails (sign-in links, invitations). Without these the backend falls back to http://localhost:3000.
LEARNHOUSE_FRONTEND_DOMAIN=<your-domain>
LEARNHOUSE_SSL=true

# Refuse public sign-ups that do not carry the accepted legal version (Terms, Privacy Policy, consent)
LEARNHOUSE_REQUIRE_LEGAL_CONSENT=true

