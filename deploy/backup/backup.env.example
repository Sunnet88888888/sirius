# Copy to <stack>/backup/backup.env (chmod 600). A key limited to the backup bucket only.
AWS_ACCESS_KEY_ID=<backup-bucket-access-key>
AWS_SECRET_ACCESS_KEY=<backup-bucket-secret-key>
AWS_DEFAULT_REGION=ru-7
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
BACKUP_S3_ENDPOINT=https://s3.ru-7.storage.selcloud.ru
BACKUP_S3_BUCKET=<backup-bucket>
BACKUP_ALERT_EMAIL=<where failures are emailed>
# Retention: day folders older than BACKUP_KEEP_DAYS (default 35) are removed with all their versions; BACKUP_PRUNE=0 turns it off
# (then use a lifecycle rule in the Selectel panel).
